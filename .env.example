# Optional for cars web: SQLite and a persistent local secret work without .env.
# Copy this file to .env in the repository root and run: cars --env .env web
# The root .env takes priority over reference-parser-daa/.env.
# --env selects an explicit file. Existing process variables take priority.
CARS_DATABASE=sqlite
# Absolute writable directory; default: reference-parser-daa/runtime
# CARS_DATA_DIR=C:/cars-data
# Required only for cars bot; never commit a real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=
SOURCES_PROXY_URL=
AVITO_PROXY_URL=
AVITO_TRANSPORT=http
# Empty: local Chrome via Selenium Manager. Install Chrome first.
# Docker: http://chrome_driver:4444/wd/hub
SELENIUM_URL=
SEARCH_MAX_PAGES=2
SEARCH_INTERVAL_SECONDS=300
# Optional PostgreSQL instead of SQLite:
# CARS_DATABASE=postgres
# DJANGO_SECRET_KEY=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=cars
# POSTGRES_USER=cars
# POSTGRES_PASSWORD=
